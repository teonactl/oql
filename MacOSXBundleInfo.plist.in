<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>OQL</string>
    <key>CFBundleIconFile</key>
    <string>oql</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>com.oql.oql</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>OQL</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>LSEnvironment</key>
    <dict>
        <key>QT_QPA_PLATFORM</key>
        <string>cocoa</string>
    </dict>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Senza questa chiave macOS termina il processo (non lo nega e basta)
         al primo accesso al microfono da parte di MicCue/RecordCue. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>OQL usa il microfono per le cue Microfono e Registrazione.</string>
    <!-- Associa i file .oql a OQL (doppio clic / "Apri con" in Finder). -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>OQL Workspace</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.oql.oql.workspace</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>oql</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>oql</string>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.oql.oql.workspace</string>
            <key>UTTypeDescription</key>
            <string>OQL Workspace</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>oql</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
